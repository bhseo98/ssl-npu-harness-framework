<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="kernel-bypass-overview" name="커널 우회 한눈에">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="amdsharktank 커널 우회 — 왜(동기) · 어떻게(수법) 한눈에   |   공통: torch.export 엔 BLACKBOX, lowering 에 손수 짠 MLIR 을 splice" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#1f2933;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1370" height="36" as="geometry" />
        </mxCell>

        <!-- ===== Section A: splice mechanism ===== -->
        <mxCell id="secA" value="A. 공통 메커니즘 — splice (4개 커널 모두 동일)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#37474f;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="500" height="22" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="nn.Module.forward&#10;= 모델 정의 (traceable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="torch.ops.amdsharktank.X(...)&#10;= &lt;b&gt;BLACKBOX&lt;/b&gt; (CustomOp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="397" y="92" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="torch.export → FX 그래프&#10;opaque op (aten.* 안 보임)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="754" y="92" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="aot.export generate()&#10;util.func @X &lt;b&gt;splice&lt;/b&gt; + util.call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1111" y="92" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ea1" value="호출" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" value="trace" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" value="lowering" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Section B: 4 kernels ===== -->
        <mxCell id="secB" value="B. 네 커널 — 표준 aten(회피·빨강) → 우회 IR(초록) · 동기(노랑) · 비-IREE NPU 판정" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#37474f;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="800" height="22" as="geometry" />
        </mxCell>

        <!-- column 1: RoPE -->
        <mxCell id="h1" value="① RoPE&#10;rope_select_concat&#10;(@mlir_kernel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="208" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="표준: aten.cat([x1,x2], -1)&#10;✗ concat = fusion 차단벽&#10;중간 버퍼 materialize" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="262" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="linalg.generic + arith.select&#10;(idx 0→x1, 1→x2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="354" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="왜: RoPE→KVwrite→attn fusion 사슬 유지&#10;(concat 을 elementwise select 로 치환)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="412" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="△ 표준 linalg 면 가능&#10;(외부 util.func 형태면 unknown)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ff8f00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="478" width="320" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ek1" value="우회" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="s1" target="i1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- column 2: KV gather -->
        <mxCell id="h2" value="② KVCacheGatherKernel&#10;(@mlir_kernel) · decode 전용" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="397" y="208" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="표준: aten.index / gather&#10;page_ids 간접참조&#10;✗ 6D paged slab 부적합" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="397" y="262" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="extract_slice (t/p_id)&#10;+ iree_linalg_ext.gather dimension_map=[0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="397" y="354" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="왜: data-dependent paged lookup 을&#10;schedulable indirect DMA 로" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="397" y="412" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="✗ IREE 전용 dialect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="397" y="478" width="320" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ek2" value="우회" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="s2" target="i2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- column 3: q8 -->
        <mxCell id="h3" value="③ mmt_block_scaled_q8 ⭐&#10;(CustomOp) · INT8 핵심" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a148c;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="754" y="208" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="표준: a @ dequant(qs,d)&#10;✗ fp weight 통째 materialize&#10;→ 양자화 메모리 이득 소멸" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="754" y="262" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="dequant generic + grouped-mm generic&#10;(한 util.func, fused)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="754" y="354" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="왜: dequant 을 mm 타일 안으로 fuse&#10;→ weight 는 DRAM 에 int8 유지" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="754" y="412" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="△ 표준 linalg 가능, 단 dequant→mm&#10;fuse 강제 필요 (그래야 int8 이득)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ff8f00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="754" y="478" width="320" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ek3" value="우회" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="s3" target="i3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- column 4: flash -->
        <mxCell id="h4" value="④ flash_attention / masked&#10;(@mlir_kernel ×2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474f;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1111" y="208" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="표준: softmax(QK^T·scale)@V&#10;✗ O(seq²) score matrix materialize&#10;+ 다중 패스" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1111" y="262" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="iree_linalg_ext.attention&#10;(1 op, online-softmax)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1111" y="354" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="왜: score matrix 안 만듦&#10;(긴 seq 메모리 폭발 방지)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1111" y="412" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="✗ IREE 전용 (Llama default 는 export 층&#10;aten._sdpa_flash_for_cpu 로 별개)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1111" y="478" width="320" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ek4" value="우회" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="1" source="s4" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Section C: verdict ===== -->
        <mxCell id="verdict" value="공통 동기 = fusion / 중간텐서 materialize 회피   ·   대가 = ②④ 는 IREE 전용 dialect → 비-IREE NPU portability 빚&#10;on-device 해법: 표준 aten/linalg 로 되돌리고 (RoPE→cat · gather→재계산/index_select · q8→block dequant-mm · flash→분해/NPU 네이티브 attn), fusion 은 NPU 컴파일러가 책임   ·   = LlamaOnDevice / WhisperForwardOnly (server_side_op_hits {})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=11;fontStyle=0;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="548" width="1391" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ec" value="" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="a4" target="verdict"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="q8-int8-dataflow" name="③ q8 INT8 dataflow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="③ mmt_block_scaled_q8 — INT8 dequant-fused matmul (한눈에)   |   weight 를 int8 로 유지하는 핵심" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#4a148c;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1370" height="36" as="geometry" />
        </mxCell>

        <!-- inputs -->
        <mxCell id="qs" value="qs : tensor&lt;N×(K/32)×32 × i8&gt;&#10;(양자화 weight, &lt;b&gt;int8&lt;/b&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d" value="d : tensor&lt;N×(K/32)×1 × fp&gt;&#10;(per-block scale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="184" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a" value="a : tensor&lt;B×M×K × fp&gt;&#10;(activation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="280" height="64" as="geometry" />
        </mxCell>

        <!-- dequant generic -->
        <mxCell id="deq" value="linalg.generic #dequant&#10;extsi i8→i32 → sitofp → mulf × scale d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="320" height="84" as="geometry" />
        </mxCell>
        <mxCell id="bg" value="b_grouped (fp, 타일-로컬)&#10;tensor&lt;N×G×BS × fp&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="260" height="64" as="geometry" />
        </mxCell>

        <!-- expand_shape -->
        <mxCell id="exp" value="tensor.expand_shape&#10;a → aexp [B,M,G,BS]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="340" width="320" height="64" as="geometry" />
        </mxCell>

        <!-- grouped mm -->
        <mxCell id="mm" value="linalg.generic #grouped-mm&#10;mulf + addf, reduction (G, BS)&#10;f32 accum" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="320" height="84" as="geometry" />
        </mxCell>
        <mxCell id="cast" value="linalg.copy (cast)&#10;c : tensor&lt;B×M×N × fp&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1180" y="290" width="230" height="64" as="geometry" />
