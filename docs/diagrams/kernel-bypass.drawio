        <!-- naive contrast -->
        <mxCell id="naive" value="✗ 순진한 경로:&#10;dequant(qs,d) → fp weight 전체 materialize&#10;→ 양자화 메모리 이득 소멸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="340" height="80" as="geometry" />
        </mxCell>
        <!-- punchline -->
        <mxCell id="punch" value="핵심: 두 generic 이 &lt;b&gt;한 util.func&lt;/b&gt; → IREE 가 dequant 을 mm 타일 안으로 &lt;b&gt;fuse&lt;/b&gt; → weight 는 DRAM 에 &lt;b&gt;int8 로 유지&lt;/b&gt;, dequant 은 타일 단위 레지스터에서만. 이게 INT8 이 실제로 메모리를 아끼게 만드는 지점." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="1010" height="80" as="geometry" />
        </mxCell>

        <mxCell id="src2" value="소스: kernels/mmt_block_scaled_q8.py (CustomOp select/generate) + kernels/templates/mmt_block_scaled_q8_3d.mlir (dequant generic + grouped-mm generic)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="40" y="566" width="1370" height="22" as="geometry" />
