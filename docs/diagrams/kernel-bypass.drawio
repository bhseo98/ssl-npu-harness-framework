        <!-- edges -->
        <mxCell id="q_deq" style="endArrow=classic;html=1;" edge="1" parent="1" source="qs" target="deq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d_deq" style="endArrow=classic;html=1;" edge="1" parent="1" source="d" target="deq"><mxGeometry relative="1" as="geometry" /></mxCell>
