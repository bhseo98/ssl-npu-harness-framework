        <mxCell id="t" value="시스템 아키텍처 ① — 컨테이너 / 배포 뷰 (빌드타임=5번, 런타임 호스트=4번, 추론=VP)" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1060" height="28" as="geometry"/></mxCell>

        <!-- build-time zone -->
        <mxCell id="z5" value="빌드타임 — server5 (gpu5-lab, canonical 개발)" style="rounded=1;html=1;fillColor=#eef2ff;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="330" height="540" as="geometry"/></mxCell>
        <mxCell id="b51" value="harness framework (Python)&#10;BaseStage·registry·pipeline·profiler&#10;target 선정·모델 swap" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="96" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="b52" value="② lowering 계층 (컴파일러 트랙)&#10;exporters · block_scaled_q8 CustomOp&#10;→ INT8 vmfb (IREE/NPU 미래)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="172" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="b53" value="모델 변환: HF → GGUF/ggml&#10;whisper-tiny → ggml · Llama-3.2-1B → GGUF Qx&#10;(llama.cpp convert + quantize)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="248" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="b54" value="riscv64 크로스컴파일 (static)&#10;whisper.cpp · llama.cpp · (TTS 엔진)&#10;-static-libstdc++ · GGML_RV_*=OFF" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="324" width="290" height="64" as="geometry"/></mxCell>
        <mxCell id="b55" value="산출물 (4번으로 전달되는 것만):&#10;• riscv64 static 엔진 바이너리&#10;• GGUF/ggml 가중치&#10;※ Python 프레임워크는 안 감(크로스컴파일 불가)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="290" height="84" as="geometry"/></mxCell>
        <mxCell id="b56" value="① 서버 디딤돌(검증용): web_demo가 5번에서 추론까지 — VP 없이 (이미 완료, UI/파이프라인 검증)" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="492" width="290" height="40" as="geometry"/></mxCell>

        <!-- runtime host zone -->
        <mxCell id="z4" value="런타임 호스트 — server4 (gpu4-lab)" style="rounded=1;html=1;fillColor=#e8f6ee;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="430" height="540" as="geometry"/></mxCell>
        <mxCell id="h41" value="web_demo (FastAPI + WebSocket)&#10;GET / · WS /ws · 16kHz PCM16&#10;토스 UI · 꾹눌러 말하기(press-and-hold)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="390" height="60" as="geometry"/></mxCell>
        <mxCell id="h42" value="호스트 오케스트레이터 (harness host-side)&#10;Pipeline.run() = STT→LLM→TTS 순차&#10;profiler: per-stage latency/RSS · 2GB budget" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="430" y="172" width="390" height="64" as="geometry"/></mxCell>
        <mxCell id="h43" value="vp_* 어댑터 (BaseStage 구현)&#10;vp_whisper · vp_llama · vp_tts&#10;= 콘솔 호출(docker exec -i, stdin 주입) + 모델 볼륨 I/O" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="430" y="248" width="390" height="64" as="geometry"/></mxCell>

        <!-- VP guest -->
