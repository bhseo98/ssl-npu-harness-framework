        <mxCell id="lle" style="endArrow=none;html=1;dashed=1;strokeColor=#999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="92"/><mxPoint x="1020" y="580"/></mxGeometry></mxCell>

        <mxCell id="m1" value="1. 꾹 누름 → PCM16 16kHz 스트림 (WS)" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="120"/><mxPoint x="330" y="120"/></mxGeometry></mxCell>
