  <diagram id="arch-component" name="2. Component">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" page="1" pageWidth="1080" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="시스템 아키텍처 ② — 컴포넌트 뷰 (좁은 인터페이스 · config-driven swap · 2개 swap 이음새)" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1040" height="28" as="geometry"/></mxCell>

        <!-- core -->
        <mxCell id="core" value="프레임워크 코어 (main, 불변 — branch 격리 불변량: git diff main &lt;app&gt; -- core = ∅)" style="rounded=1;html=1;fillColor=#eef2ff;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1010" height="150" as="geometry"/></mxCell>
        <mxCell id="c1" value="BaseStage (ABC)&#10;__call__(payload)→Any&#10;좁은 인터페이스 (Ousterhout)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="92" width="220" height="64" as="geometry"/></mxCell>
        <mxCell id="c2" value="registry&#10;@register(stage,name) · build(stage,cfg)&#10;composition root = swap 단일 지점" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="92" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="c3" value="Pipeline.run()&#10;STT→LLM→TTS linear chain" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="550" y="92" width="220" height="64" as="geometry"/></mxCell>
        <mxCell id="c4" value="profiler.measure()&#10;latency · RAM/RSS · 2GB budget 경고&#10;cross-cutting (stage는 모름)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="92" width="230" height="64" as="geometry"/></mxCell>
        <mxCell id="cseam" value="◀ swap 이음새 A: YAML `type:` 한 줄 → build()가 dispatch. app·Pipeline·test는 구체 클래스 모름. 새 모델 = @register 한 줄." style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="166" width="970" height="30" as="geometry"/></mxCell>

        <!-- stage impls: two backends -->
        <mxCell id="impl" value="Stage 구현 (BaseStage 구현체 — 배포 타깃별, additive)" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="1010" height="170" as="geometry"/></mxCell>
        <mxCell id="s_srv" value="① 서버 네이티브 (Python+PyTorch, GPU/CPU)&#10;faster-whisper · transformers Llama · espnet/piper&#10;→ Deliverable ① (검증 완료)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="262" width="460" height="116" as="geometry"/></mxCell>
        <mxCell id="s_vp" value="③ vp_* 콘솔 어댑터 (riscv64 native 호출)&#10;vp_whisper → whisper.cpp · vp_llama → llama.cpp · vp_tts&#10;콘솔(stdin 주입) + 모델 볼륨 I/O + 출력 파싱&#10;→ Deliverable ③ (구현 예정)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="262" width="480" height="116" as="geometry"/></mxCell>

        <!-- lowering layer -->
        <mxCell id="low" value="② lowering 계층 (PyTorch→MLIR 프레임워크) — 컴파일러 트랙" style="rounded=1;html=1;fillColor=#f3eefb;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="418" width="1010" height="190" as="geometry"/></mxCell>
        <mxCell id="l1" value="exporters (sibling, additive)&#10;torch_mlir.compile / iree.turbine.aot&#10;analysis → server_side_op_hits" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="452" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="l2" value="block_scaled_q8 CustomOp&#10;INT8 qs + per-block scale, dequant fuse&#10;tied-weight skip(proj_out) → vmfb 103MB" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="370" y="452" width="320" height="74" as="geometry"/></mxCell>
        <mxCell id="l3" value="vmfb → IREE-CPU / riscv64&#10;WM3: rel 0.61% / argmax 100%" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="710" y="452" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="lseam" value="◀ swap 이음새 B: MICROKERNEL_BACKEND = &quot;standard&quot; → &quot;sslnpu&quot; (마이크로커널 본체만 교체, select/dispatch/모델클래스 불변)" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="536" width="970" height="24" as="geometry"/></mxCell>
        <mxCell id="ltrack" value="두 양자화 트랙: GGUF Q-native(llama.cpp/whisper.cpp) = VP 실배포(지금) │ block_scaled_q8 INT8 vmfb = IREE→NPU(미래). 같은 모델, 다른 포맷·엔진." style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="970" height="34" as="geometry"/></mxCell>

        <mxCell id="ea" style="endArrow=open;html=1;dashed=1;" edge="1" parent="1" source="c2" target="impl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el" style="endArrow=classic;html=1;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el2" style="endArrow=classic;html=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="arch-sequence" name="3. Runtime Sequence">
