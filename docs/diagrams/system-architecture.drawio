        <mxCell id="vp1" value="whisper.cpp&#10;(whisper-tiny ggml ~40MB)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="448" y="362" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="vp2" value="llama.cpp&#10;(Llama-3.2-1B GGUF Q6_K)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="448" y="424" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="vp3" value="TTS 엔진 (riscv64)&#10;sherpa-onnx/piper KO" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="448" y="486" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="vpv" value="모델 볼륨 (sdcard.img)&#10;GGUF/ggml 가중치&#10;⚠ 20MB initramfs window 우회&#10;엔진=rootfs 고정, 모델=볼륨" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="636" y="362" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="vpos" value="Linux 6.16 / OpenSBI · rootfs.cpio(엔진 고정)" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="448" y="540" width="358" height="20" as="geometry"/></mxCell>

        <!-- browser -->
        <mxCell id="br" value="브라우저 = 사용자 Mac&#10;🎙 push-to-talk · 🔊 스피커&#10;ssh -L 터널" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="note" value="런타임 경로에 5번 없음.&#10;5번=빌드타임만.&#10;호스트=4번(VP와 co-located)→&#10;오케스트레이터가 VP 콘솔 로컬 구동." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="170" height="110" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="e_build" value="빌드 산출물 (엔진+GGUF), 1회" style="endArrow=classic;html=1;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="z5" target="z4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ws" value="WS (PCM16 / wav)" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="br" target="h41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_orch" style="endArrow=classic;html=1;" edge="1" parent="1" source="h41" target="h42"><mxGeometry relative="1" as="geometry"/></mxCell>
