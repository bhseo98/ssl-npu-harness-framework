        <mxCell id="m6" value="6. reply text" style="endArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="322"/><mxPoint x="570" y="322"/></mxGeometry></mxCell>
        <mxCell id="m7" value="7. TTS: text → riscv64 엔진" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="360"/><mxPoint x="830" y="360"/></mxGeometry></mxCell>
        <mxCell id="m8" value="8. wav" style="endArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="394"/><mxPoint x="570" y="394"/></mxGeometry></mxCell>
