    </mxGraphModel>
  </diagram>

  <diagram id="page3" name="3·커스터마이징 포인트">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="amdsharktank export 커스터마이징 — 어디를 잡고 흔들 수 있나" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="10" width="760" height="30" as="geometry" /></mxCell>

        <mxCell id="seam" value="export_llm_v1(modelClass = PagedLlmModelV1)   ← 가장 큰 seam: modelClass 만 갈아끼우면 그래프 전체 교체" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="1360" height="40" as="geometry" /></mxCell>

        <mxCell id="k1" value="① ExportConfig 플래그 (config.py)&#10;bs_prefill/bs_decode · top_k · logits_normalization · skip_prefill/skip_decode · use_extend_attention&#10;난이도: 낮음 (CLI flag).  효과: entry 개수/sampling 제어. NPU 제약 대부분 해소 못함." style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="130" width="660" height="100" as="geometry" /></mxCell>

        <mxCell id="k2" value="② LlamaModelConfig (llm_configs.py)&#10;kv_cache_type · block_seq_stride · activation/attention_dtype · attention_kernel · matmul_kernel · tensor/pipeline_parallelism&#10;난이도: 낮음.  효과: dtype 통일(#6), slab 모양, single-device(#5)." style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="660" height="100" as="geometry" /></mxCell>

        <mxCell id="k3" value="③ @mlir_kernel 템플릿 교체 (rotary_embedding_hf.py / paged_attention.py)&#10;rope_select_concat → tensor.concat 등 표준 op,  kv_cache_gather → 표준 slice/gather&#10;난이도: 중.  효과: NPU 가 모르는 iree_linalg_ext / linalg.generic 커스텀 util.func 제거(#3,#4)." style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="660" height="100" as="geometry" /></mxCell>

        <mxCell id="k4" value="④ attention_kernel 선택 (ops.scaled_dot_product_attention impl=)&#10;'torch' / 'decomposed' / 'flash' …  → SDPA 불투명 op 를 분해 또는 다른 커널로&#10;난이도: 중.  효과: _sdpa_flash_attention_for_cpu(보라) 를 aten matmul+softmax 로 풀어 NPU 가 일반 op 로 받음." style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="250" width="660" height="100" as="geometry" /></mxCell>

        <mxCell id="k5" value="⑤ modelClass 교체 = 우리 LlamaOnDevice 패턴 (가장 근본적)&#10;forward(input_ids)→logits 단일 entry · KV cache 제거(stateless) · prefill/decode 통합 · 표준 aten 만 · fixed shape&#10;난이도: 높음(forward 재작성 ~170 LoC).  효과: easy3 의 9개 제약 중 8개 한 번에 추방. IRPA(#9)는 그대로 재사용." style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="370" width="1360" height="100" as="geometry" /></mxCell>

        <mxCell id="map" value="제약(easy3) ↔ 레버 매핑 :&#10;#1 KV state arg → ⑤   ·   #2 prefill/decode split → ①(skip)/⑤   ·   #3 paged gather → ③/⑤   ·   #4 RoPE concat → ③/⑤&#10;#5 device affinity → ②(tp=pp=1)   ·   #6 fp16 mixed → ②   ·   #7 dynamic dim → ⑤(fixed shape)+aot   ·   #8 multi-args → ⑤   ·   #9 weight → IRPA 그대로(✓)" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="500" width="1360" height="90" as="geometry" /></mxCell>

        <mxCell id="concl" value="결론: ①②④ 는 export/lowering 옵션 튜닝(빠름)이고 NPU 적합도를 부분만 올린다. ③ 은 커널 단위 수술. ⑤ (modelClass 재작성)이 9개 제약을 근본 해소 — 그게 LlamaOnDevice 가 PagedLlmModelV1 의 재구현인 이유." style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="610" width="1360" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
