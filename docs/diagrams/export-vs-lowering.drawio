<mxfile host="app.diagrams.net" agent="easy-series" version="24.0.0">
  <diagram id="page1" name="1·export-time vs lowering-time 클래스">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title1" value="Llama-3.2-1B-Instruct → amdsharktank export/lowering : 두 종류의 클래스" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="10" width="880" height="30" as="geometry" /></mxCell>
        <mxCell id="sub1" value="좌: 그래프로 traced 되는 PyTorch nn.Module (= '무엇을 lowering 하나')   ·   우: trace 안 되고 손수 짠 MLIR 를 IR 에 삽입하는 kernel 클래스 (= '어떻게 lowering 되나')" style="text;html=1;fontSize=12;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1000" height="20" as="geometry" /></mxCell>

        <!-- LEFT swimlane: export-time -->
        <mxCell id="L" value="EXPORT-TIME — traced nn.Module  (torch.export → torch dialect)" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="760" height="880" as="geometry" /></mxCell>

        <mxCell id="L_main" value="examples/export_paged_llm_v1.main()  — CLI 진입점" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L"><mxGeometry x="20" y="40" width="720" height="34" as="geometry" /></mxCell>
        <mxCell id="L_cfg" value="LlamaModelConfig.from_dataset() / LlamaHParams / ExportConfig / ParallelismConfig&#10;(IRPA properties + CLI flag → 타입화된 설정)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L"><mxGeometry x="20" y="86" width="720" height="44" as="geometry" /></mxCell>

        <mxCell id="L_model" value="PagedLlmModelV1(BaseCausalLMModel)   ← theta(...) 로 weight 주입,  prefill()/decode() 두 메서드" style="swimlane;startSize=28;html=1;fillColor=#eef5ff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="L"><mxGeometry x="20" y="142" width="720" height="470" as="geometry" /></mxCell>
        <mxCell id="L_tok" value="TokenEmbeddingLayer  →  ops.embedding_lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L_model"><mxGeometry x="16" y="38" width="688" height="30" as="geometry" /></mxCell>

        <mxCell id="L_blk" value="PagedLlamaGQAttentionBlock × 16   (AttentionFFNBlock 로 래핑)" style="swimlane;startSize=26;html=1;fillColor=#f5faff;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="L_model"><mxGeometry x="16" y="78" width="688" height="300" as="geometry" /></mxCell>
        <mxCell id="L_an" value="RMSNormLayer (attn_norm)  →  rms_norm: pow·mean·rsqrt·mul" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L_blk"><mxGeometry x="14" y="34" width="660" height="28" as="geometry" /></mxCell>
        <mxCell id="L_qkv" value="LinearLayer × 3  (attn_q / attn_k / attn_v)  →  ops.linear: mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L_blk"><mxGeometry x="14" y="68" width="660" height="28" as="geometry" /></mxCell>
        <mxCell id="L_rope" value="CachedRotaryLayer → RotaryEmbeddingLayer.forward&#10;cos/sin·mul·sub·add (표준 aten) + select_concat(➜우측 커널)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="L_blk"><mxGeometry x="14" y="102" width="660" height="40" as="geometry" /></mxCell>
        <mxCell id="L_attn" value="PagedGQAttention (PagedMHAttention)&#10;write(K,V)→cache · read(➜우측 gather, decode만) · attention=SDPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="L_blk"><mxGeometry x="14" y="148" width="660" height="44" as="geometry" /></mxCell>
        <mxCell id="L_o" value="LinearLayer (attn_output)  →  mm   +   residual add" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L_blk"><mxGeometry x="14" y="198" width="660" height="28" as="geometry" /></mxCell>
        <mxCell id="L_fn" value="RMSNormLayer (ffn_norm)  +  FFN (SwiGLU: gate·up·down LinearLayer, silu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L_blk"><mxGeometry x="14" y="232" width="660" height="40" as="geometry" /></mxCell>

        <mxCell id="L_on" value="RMSNormLayer (output_norm)  +  LinearLayer (output = lm_head)  →  mm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L_model"><mxGeometry x="16" y="390" width="688" height="40" as="geometry" /></mxCell>
        <mxCell id="L_kv" value="DefaultPagedKVCache (PagedKVCache)  — slab[?,524288],  read()/write()/write_timestep()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="L_model"><mxGeometry x="16" y="432" width="688" height="30" as="geometry" /></mxCell>

        <mxCell id="L_svc" value="ServicePagedLlmModelV1(torch.nn.Module)  — prefill/decode 래핑 + logits_norm + top_k + setup_cache/setup_arg_devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L"><mxGeometry x="20" y="624" width="720" height="44" as="geometry" /></mxCell>
        <mxCell id="L_fx" value="iree.turbine.aot :  FxProgramsBuilder + @fxb.export_program(torch.export.Dim) + export()&#10;→ ExportOutput.save_mlir()  →  llama-3.2-1b.mlir (27,269 lines, entry: prefill_bs1 / decode_bs1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="L"><mxGeometry x="20" y="684" width="720" height="50" as="geometry" /></mxCell>

        <!-- RIGHT swimlane: lowering-time -->
        <mxCell id="R" value="LOWERING-TIME — @mlir_kernel / CustomOp 가 손수 짠 MLIR 를 IR 에 삽입 (trace 안 함)" style="swimlane;startSize=30;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="720" height="880" as="geometry" /></mxCell>

        <mxCell id="R_infra" value="kernels/mlir_kernel.py 인프라&#10;@mlir_kernel · MLIRSpec · KernelBuilder · inline_template_function · CustomOp&#10;(FX 노드가 이 커널을 호출하면 → 템플릿 MLIR util.func 를 그대로 출력 IR 에 splice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="R"><mxGeometry x="20" y="44" width="680" height="64" as="geometry" /></mxCell>

        <mxCell id="R_rope" value="RoPEKernels.rope_select_concat   (@mlir_kernel)&#10;layers/rotary_embedding_hf.py:36&#10;→ util.func @rope_select_concat (linalg.generic + arith.select)&#10;호출: prefill 32 + decode 32 = 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="R"><mxGeometry x="20" y="140" width="680" height="84" as="geometry" /></mxCell>

        <mxCell id="R_gather" value="KVCacheGatherKernel   (@mlir_kernel)&#10;layers/paged_attention.py:68&#10;→ util.func @paged_attention_kv_cache_gather (tensor.extract_slice + iree_linalg_ext.gather)&#10;호출: prefill 0 + decode 32 = 32   ← decode 전용!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="R"><mxGeometry x="20" y="248" width="680" height="84" as="geometry" /></mxCell>

        <mxCell id="R_aff" value="DeviceAffinity (iree.turbine.aot)&#10;→ 모든 arg/result 에 iree.abi.affinity=#hal.device.promise&lt;@__device_0&gt; attribute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="R"><mxGeometry x="20" y="356" width="680" height="50" as="geometry" /></mxCell>

        <mxCell id="R_sdpa" value="SDPA 는 커스텀 아님 — torch.operator&#10;'torch.aten._scaled_dot_product_flash_attention_for_cpu'&#10;단일 불투명 op 로 유지 (bmm/softmax 로 분해 안 됨, _softmax 0개). 32회(prefill16+decode16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="R"><mxGeometry x="20" y="430" width="680" height="70" as="geometry" /></mxCell>

        <mxCell id="R_note" value="요점:&#10;• 좌측 nn.Module = torch.export 가 FX 그래프로 추적 → torch.aten.* 로 lowering&#10;• 우측 @mlir_kernel = 추적되지 않고, 호출 지점에 손수 짠 util.func 를 직접 emit&#10;• 그래서 IR 에는 'torch.aten.* (좌)' + 'iree_linalg_ext / linalg.generic 커스텀 util.func (우)' 가 섞임&#10;• NPU 컴파일러가 막히는 건 거의 우측 2개(gather, select_concat) + SDPA 불투명 op + affinity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="R"><mxGeometry x="20" y="524" width="680" height="120" as="geometry" /></mxCell>

        <!-- cross edges -->
        <mxCell id="e_rope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="L_rope" target="R_rope"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gather" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="L_attn" target="R_gather"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_aff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="L_svc" target="R_aff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sdpa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="L_attn" target="R_sdpa"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

