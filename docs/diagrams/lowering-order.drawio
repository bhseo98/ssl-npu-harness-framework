    <diagram id="p5-intake" name="⑤ 임의 모델 입고 순서">
        <mxGraphModel dx="567" dy="516" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="임의 PyTorch/HF 모델을 zoo 에 올리는 작업 순서 — IRPA 는 6번째일 뿐" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#1e293b;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="1080" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="tb" value="&#39;fixed IRPA 만 하면 다 되나?&#39; → 아니오. 1~5 를 먼저 해야 하고, IRPA(6) 는 weight 처리 1개만 담당" style="text;html=1;align=center;fontSize=12;fontColor=#64748b;" parent="1" vertex="1">
                    <mxGeometry x="40" y="46" width="1080" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="i1" value="1. forward 를 stateless 단일 entry 로&#xa;KV cache · prefill/decode 분리 제거" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="80" width="520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i2" value="2. custom kernel 회피&#xa;paged_attention / rope / flash-attn → 표준 aten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="150" width="520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i3" value="3. (HF 모델이면) 가드 4줄&#xa;attn_implementation=eager · eval · use_cache=False · return_dict=False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="220" width="520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i4" value="4. fixed shape 로 trace&#xa;example_args 로 dynamic dim 제거" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="290" width="520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i5" value="5. dtype 단일화 + single device&#xa;mixed-precision / affinity 정리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=center;" parent="1" vertex="1">
                    <mxGeometry x="320" y="360" width="520" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="i6" value="6. weight 외부화 !!! &quot;fixed IRPA&quot; 는 여기 1개&lt;br&gt;IRPA / externalize_module_parameters&lt;br&gt;(+ tied embedding 등 모델별 weight 수선)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=3;fontSize=12;align=center;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="320" y="430" width="520" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="i7" value="7. export → analyze → iree-compile → .vmfb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;strokeWidth=2;fontSize=12;align=center;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="320" y="520" width="520" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="call" value="1~5 = 모델 forward 코드 자체의&#xa;재구성&#xa;(= 경로 B / LlamaOnDevice 가&#xa;한 일)&#xa;&#xa;6 = IRPA 의 역할&#xa;(9개 중 1개만)&#xa;&#xa;∴ &quot;fixed IRPA = 만능키&quot;&#xa;는 거짓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#a855f7;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;fontColor=#6b21a8;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="880" y="80" width="240" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="ie1" style="html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" parent="1" source="i1" target="i2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie2" style="html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" parent="1" source="i2" target="i3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie3" style="html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" parent="1" source="i3" target="i4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie4" style="html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=classic;" parent="1" source="i4" target="i5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie5" style="html=1;strokeColor=#ea580c;strokeWidth=2;endArrow=classic;" parent="1" source="i5" target="i6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ie6" style="html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=classic;" parent="1" source="i6" target="i7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
