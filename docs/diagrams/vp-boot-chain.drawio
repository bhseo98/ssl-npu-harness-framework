<mxfile host="app.diagrams.net" type="device">
  <diagram id="vp-boot" name="VP Boot Chain">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" page="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="ssl-soc-gen2 VP 부팅 체인 (실측) — RISC-V64 · DDR3 2GB · CPU-only" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="840" height="30" as="geometry"/></mxCell>

        <mxCell id="b1" value="Reset vector&#10;0x00001000" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="b2" value="ZeroStage ROM&#10;0x20000000&#10;simple_bootrom.elf" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="b3" value="BootRAM/SRAM&#10;0x20020000 (256KB)&#10;simple_jump_boot.elf" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="b4" value="OpenSBI v1.5 (M-mode)&#10;0x80000000&#10;fw_payload.bin 27M&#10;(+ DTB @0x82200000)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="b5" value="Linux 6.16 (S-mode)&#10;0x80200000" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="710" y="75" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="b6" value="initramfs (rootfs.cpio)&#10;0x83000000&#10;⚠ initrd window 고정(~20MB, DTB)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="170" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="b7" value="/sbin/init → getty&#10;login: ttySIF0 115200&#10;(root, 무패스워드)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="120" height="56" as="geometry"/></mxCell>

