        <mxCell id="mm" value="DDR3 메모리 맵 (0x80000000–0xFFFFFFFF, 2GB)" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#999;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="m1" value="0x80000000  OpenSBI+Kernel (fw_payload)&#10;0x80200000  Linux kernel&#10;0x82200000  DTB&#10;0x83000000  initramfs (rootfs.cpio)&#10;0x83000000+  (rootfs.cpio→ +offset / 모델은 볼륨)" style="text;html=1;align=left;fontFamily=monospace;fontSize=11;" vertex="1" parent="1"><mxGeometry x="56" y="290" width="470" height="100" as="geometry"/></mxCell>
        <mxCell id="m2" value="기타: BootROM 0x20000000(4KB) · SRAM 0x20020000(256KB) · CLINT 0x02000000 · PLIC 0x0C000000(64MB) · UART0 0x10013000 · L2 line 64B" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="392" width="470" height="40" as="geometry"/></mxCell>

        <mxCell id="run" value="실행 (stdin-injection 방식 — docker exec -i, NOT -it):&#10;{ sleep 200; printf 'root\n'; ...; } | platforms-vp --gs_luafile ...conf.lua&#10;※ docker exec -i**t**(TTY)는 부팅을 깨뜨림 → -i 사용" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="gap" value="남은 갭: 모델은 20MB initrd window 초과 → 볼륨/별도 적재 필요. llama-cli는 static 재빌드로 gguf 로드 가능(dynamic은 게스트 libstdc++ ABI 불일치로 abort)." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="300" height="70" as="geometry"/></mxCell>
