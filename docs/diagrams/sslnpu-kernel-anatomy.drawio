<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="stack-ownership" name="스택·담당 경계">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
