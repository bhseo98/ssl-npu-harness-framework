        <mxCell id="title" value="SSLNPU 스택 — 담당 경계 · 합치는 지점 · 내 천장" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#1f2933;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="840" height="34" as="geometry" />
