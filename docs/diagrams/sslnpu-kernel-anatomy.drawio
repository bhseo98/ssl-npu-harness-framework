        <mxCell id="bottom" value="안정적 계약 = CustomOp 의 select(shape/dtype 인터페이스). 내 IR 이 IREE 로 들어가고, runtime팀의 SSLNPU HAL driver 가 IREE 밑에 꽂힌다. 그 후 마이크로커널 본체만 SSLNPU intrinsic 으로 채움." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="544" width="840" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="customop-anatomy" name="CustomOp 4-파트 + swap">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="CustomOp 4-파트 — class 는 지금, 마이크로커널 본체만 인계 후 swap" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#1f2933;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="880" height="34" as="geometry" />
        </mxCell>

        <mxCell id="sig" value="signature&#10;torch schema 등록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="sel" value="select&#10;shape·dtype 계약 (안정적 계약, 불변)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe8fc;strokeColor=#1565c0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="eag" value="eager_execute&#10;순수 torch 레퍼런스 (지금 검증용)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="gen" value="generate&#10;마이크로커널 방출 (이 한 곳만 교체)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="240" height="60" as="geometry" /></mxCell>

        <mxCell id="now" value="지금 (포터블)&#10;표준 linalg .mlir&#10;→ CPU-IREE 검증 ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="later" value="인계 후 (swap)&#10;SSLNPU intrinsic .mlir&#10;→ 실제 칩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="240" width="240" height="60" as="geometry" /></mxCell>

        <mxCell id="a1" style="endArrow=classic;html=1;" edge="1" parent="1" source="sig" target="sel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=classic;html=1;" edge="1" parent="1" source="sel" target="eag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=classic;html=1;" edge="1" parent="1" source="sel" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="지금" style="endArrow=classic;html=1;fontSize=10;strokeColor=#2e7d32;" edge="1" parent="1" source="gen" target="now"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="swap" style="endArrow=classic;html=1;fontSize=10;strokeColor=#c62828;dashed=1;" edge="1" parent="1" source="gen" target="later"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note2" value="Python(signature·select·generate) = 컴파일 시점 메타코드 (숫자 계산 안 함).  .mlir = 실제 계산(IREE 가 컴파일).  select(인터페이스)는 백엔드 바뀌어도 불변 → generate 한 곳만 표준 linalg → SSLNPU intrinsic 으로 교체." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="860" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
