        <mxCell id="ceil" value="내 천장 =&#10;CPU-via-IREE 컴파일·실행·수치 검증&#10;(SSLNPU 없이 기능 정확성 증명)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="276" width="230" height="64" as="geometry" />
