        <!-- 내 영역 container -->
        <mxCell id="mine" value="내 영역 (스택 최상단 점선 박스)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#2e7d32;fillColor=none;verticalAlign=top;align=right;fontColor=#2e7d32;fontStyle=1;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="500" height="208" as="geometry" />
