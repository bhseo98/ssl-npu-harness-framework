        <mxCell id="mz" value="PyTorch Model Zoo&#10;모델클래스 · CustomOp · dispatch  (구현)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="74" width="440" height="48" as="geometry" /></mxCell>
        <mxCell id="tm" value="Torch-MLIR  (torch dialect IR 생성)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="134" width="440" height="40" as="geometry" /></mxCell>
        <mxCell id="tmc" value="Torch-MLIR Compiler  (to modify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="186" width="440" height="48" as="geometry" /></mxCell>

        <!-- IREE -->
        <mxCell id="iree" value="IREE  Compiler / Runtime / VM  (기존 오픈소스)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="440" height="46" as="geometry" /></mxCell>
        <mxCell id="hal" value="IREE HAL Driver  =  합치는 지점 (integration boundary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ff8f00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="440" height="46" as="geometry" /></mxCell>

        <!-- runtime팀 container -->
        <mxCell id="team" value="runtime팀 (TBD)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#c62828;fillColor=none;verticalAlign=top;align=right;fontColor=#c62828;fontStyle=1;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="400" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lib" value="SSLNPU Library / Runtime  (구현)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="414" width="440" height="44" as="geometry" /></mxCell>
        <mxCell id="hw" value="SSLNPU Driver / HW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="440" height="44" as="geometry" /></mxCell>

