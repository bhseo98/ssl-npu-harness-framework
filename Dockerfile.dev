# syntax=docker/dockerfile:1.7
# vision-app — dev / interactive shell variant (가상환경 접속용, *harness 권장*).
#
# Sibling of `Dockerfile` (CI / 일회성 실행). 같은 CPU-only base + torch CPU +
# torchvision + 추가 dev tools (vim/jq/less/ipython) + CMD bash. uniform
# contract 아래에서 backbone (ResNet/MobileNet/ViT 등) 을 자유롭게 swap 하는
# harness 의 본질에 부합.
#
# Usage (compose):
#   docker compose build dev
#   docker compose run --rm dev
#   → [vision-app:dev] /workspace $
#
# 기존 `Dockerfile` 영향 0 (sibling, additive).

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/src \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

# Interactive dev tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash-completion \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        procps \
        vim-tiny \
    && rm -rf /var/lib/apt/lists/*

# Same Python deps as Dockerfile + ipython for REPL.
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.5.1 torchvision==0.20.1 \
 && pip install Pillow pyyaml psutil pytest ipython

COPY pyproject.toml ./
COPY src ./src
COPY configs ./configs
COPY scripts ./scripts
COPY tests ./tests

RUN pip install -e ".[dev]"

# Pre-cache ResNet18 weights (offline-friendly, same as Dockerfile).
RUN python -c "from torchvision.models import resnet18, ResNet18_Weights; resnet18(weights=ResNet18_Weights.IMAGENET1K_V1)"

# Bash QoL — prompt + completion.
RUN echo 'PS1="\[\e[1;34m\][vision-app:dev]\[\e[0m\] \w \$ "' >> /root/.bashrc \
 && echo 'source /etc/bash_completion 2>/dev/null || true' >> /root/.bashrc

# Default = interactive bash (vs Dockerfile's CMD ["pytest", ...]).
CMD ["bash"]
